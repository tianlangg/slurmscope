POSTGRES_USER=slurmscope
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=slurmscope
# Published localhost ports; change them if another service uses the defaults.
API_PORT=8000
FRONTEND_PORT=5173
# The single-user API binds to 127.0.0.1; do not expose without authentication.
SLURM_ENABLED=false
SLURM_ACCOUNT=
SLURM_PARTITIONS=
WORKER_POLL_SECONDS=10
MAX_LOCAL_JOBS=2
